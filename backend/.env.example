# Copy this file to ".env" and fill in your values.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nutrivision

# Optional: protects POST endpoints. Leave empty for local development.
# Send it in the "X-API-Key" request header.
ADMIN_API_KEY=

# Optional: comma separated list of allowed frontend URLs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
